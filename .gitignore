# Byte-compiled output. Python writes these beside every module, so without
# them each run drops compiled artefacts into git history.
*$py.class

# Editor, tooling and patch leftovers.
*.bak
*.key
*.orig
*.py[cod]
*.rej
*.tmp
*~

.scratch/
__pycache__/

# Secrets and local-only config.
config.json

# Runtime logs and one-off test artefacts.
data/**/*.log

# Volatile runtime state.
data/*.pid

# selftest.py output. It snapshots the whole worktree on every run, so without
# these the snapshot would sweep its own output back into the commit.
data/.selftest_baseline.json
data/.selftest_scratch/
run_new.log
err_new.log

# Persistent memory, audit ledger and Phase 5 state (business/CRM/content/
# trading ledgers and alerts), never committed. The single glob also covers any
# new JSONL ledger added later. Excluded by MEMORY_GLOBS in
# jarvis_os/selfupdate.py, so this is defence in depth.
data/*.jsonl
data/audit.db*
data/control/
data/control.token
data/heartbeat.json
data/jarvis_daemon.log
data/memory_index.db
data/memory_index.db-*
data/plan_state.json

# Device sync secrets: local TLS material and the pairing token are generated
# per install and must never reach git (like config.json above).
data/pairing.token
data/tls/

# Live daemon runtime state: pid and overseer control records are rewritten
# while a background Jarvis runs, so they must never be tracked (like the
# *.pid / heartbeat entries above).
data/daemon_state.json
data/overseer_control.json

# Offline model caches: multi-GB and re-downloadable, never committed.
data/langcache/
data/lessons.jsonl
data/memory.db
data/memory.db-*
data/models/
models/
data/selftest_run*.err
data/selftest_run*.log
data/smoke.txt
data/vectors.json
data/vectors.json.tmp

# machine-local agent/tooling config, not part of the shipped kernel
opencode.json

# Scratch directories.
scratch/
temp/
tmp/

# Persistent memory and audit ledger, never committed.
data/actions.jsonl
data/audit_ledger.jsonl
